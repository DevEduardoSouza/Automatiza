[global]
repo1-type=s3
repo1-s3-endpoint=replace-with-approved-endpoint
repo1-s3-bucket=replace-with-separate-account-bucket
repo1-s3-region=replace-with-region
repo1-path=/automatiza/postgres-pitr
repo1-retention-full=4
repo1-retention-diff=14
expire-auto=n
repo1-bundle=y
repo1-block=y
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=replace-outside-repository
spool-path=/var/spool/pgbackrest
process-max=2
start-fast=y

[automatiza]
pg1-path=/var/lib/postgresql/data
pg1-port=5432
pg1-user=automatiza
