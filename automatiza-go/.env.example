# =============================================================================
# Automatiza Backend - Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=automatiza
DB_PASSWORD=your_db_password
DB_NAME=automatiza
DB_SSLMODE=disable
DB_MAX_CONNS=25

# Redis Configuration
CACHE_REDIS_URI=redis://localhost:6379/0

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Security Keys (generate random 64-char hex strings)
JWT_SECRET=your_jwt_secret_64_chars_hex
TOKEN_HMAC_KEY=your_token_hmac_key_64_chars_hex
ML_CREDENTIALS_ENCRYPTION_KEY=your_ml_encryption_key_64_chars_hex

# WAHA Configuration
WAHA_API_URL=http://localhost:3001
WAHA_API_KEY=your_waha_api_key

# CORS and Cookie Configuration
CORS_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:3000
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Timezone
TZ=America/Sao_Paulo

# Kiwify Webhook
KIWIFY_WEBHOOK_TOKEN=your_kiwify_token

# =============================================================================
# SMTP Configuration (Gmail)
# =============================================================================
# To use Gmail SMTP:
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use that App Password below (remove spaces)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_no_spaces
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Automatiza

# =============================================================================
# Production Values (example for astecwms.com.br)
# =============================================================================
# CORS_ORIGIN=https://astecwms.com.br
# PUBLIC_BASE_URL=https://astecwms.com.br
# BACKEND_PUBLIC_URL=https://astecwms.com.br
# COOKIE_DOMAIN=astecwms.com.br
# COOKIE_SECURE=true
# NODE_ENV=production
