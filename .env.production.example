# Automatiza Production Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit the actual .env file!

# ===========================================
# Database
# ===========================================
DATABASE_URL=postgres://automatiza:YOUR_STRONG_PASSWORD@localhost:5432/automatiza?sslmode=disable
DB_PASSWORD=YOUR_STRONG_PASSWORD

# ===========================================
# Redis
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# Server Configuration
# ===========================================
PORT=3000
ENV=production
LOG_LEVEL=info

# ===========================================
# Security Keys (GENERATE RANDOM STRINGS!)
# Use: openssl rand -hex 32
# ===========================================
JWT_SECRET=GENERATE_64_CHAR_RANDOM_STRING
TOKEN_HMAC_KEY=GENERATE_64_CHAR_RANDOM_STRING
ML_CREDENTIALS_ENCRYPTION_KEY=GENERATE_64_CHAR_RANDOM_STRING

# ===========================================
# WhatsApp (WAHA Plus)
# ===========================================
WAHA_URL=http://localhost:3001
WAHA_API_KEY=YOUR_WAHA_API_KEY

# ===========================================
# Email (SMTP - Gmail)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# ===========================================
# AI Service (Google Gemini)
# ===========================================
AI_API_KEY=YOUR_GEMINI_API_KEY
AI_MODEL=gemini-1.5-flash

# ===========================================
# Application URLs
# ===========================================
APP_URL=https://rendarapida.com
CORS_ORIGINS=https://rendarapida.com,https://www.rendarapida.com

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ===========================================
# File Upload
# ===========================================
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=/opt/automatiza/uploads

# ===========================================
# Mercado Livre (if using)
# ===========================================
# ML_CLIENT_ID=
# ML_CLIENT_SECRET=
# ML_REDIRECT_URI=https://rendarapida.com/api/v1/auth/mercadolivre/callback
