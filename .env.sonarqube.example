# =============================================================================
# SonarQube Environment Variables
# =============================================================================
# Copy this file to .env.sonarqube and fill in the values
# =============================================================================

# SonarQube Server
SONARQUBE_PORT=9000

# SonarQube Database
SONARQUBE_DB_USER=sonarqube
SONARQUBE_DB_PASSWORD=sonarqube_password_change_me

# Analysis Token (generated after first setup)
# Run: make sonar-setup to generate this token
SONAR_TOKEN=

# SonarQube URL (for scanner)
SONAR_URL=http://localhost:9000/sonarqube
